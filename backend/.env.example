NODE_ENV=
PORT=

# Local MongoDB:
MONGODB_URI=
MONGODB_DB_NAME=preparena

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/preparena?retryWrites=true&w=majority

# Comma-separated frontend origins allowed by CORS.
CLIENT_ORIGIN=https://www.chandrabhagaacademy.com,https://chandrabhagaacademy.com

# Admin seeder credentials (required only when running npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=a
ADMIN_PASSWORD=
ADMIN_MOBILE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
