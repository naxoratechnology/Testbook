NODE_ENV=development
PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/preparena
MONGODB_DB_NAME=preparena

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/preparena?retryWrites=true&w=majority

# Comma-separated frontend origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# Admin seeder credentials (required only when running npm run seed:admin)
ADMIN_NAME=PrepArena Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_MOBILE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
