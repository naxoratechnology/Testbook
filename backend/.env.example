NODE_ENV=development
PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/preparena
MONGODB_DB_NAME=preparena

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/preparena?retryWrites=true&w=majority

# Comma-separated frontend origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173
