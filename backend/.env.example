NODE_ENV=
PORT=

# Local MongoDB:
MONGODB_URI=
MONGODB_DB_NAME=preparena

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/preparena?retryWrites=true&w=majority

# Comma-separated frontend origins allowed by CORS.
CLIENT_ORIGIN=https://www.chandrabhagaacademy.com,https://chandrabhagaacademy.com
PUBLIC_WEB_URL=https://www.chandrabhagaacademy.com

# Admin seeder credentials (required only when running npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=a
ADMIN_PASSWORD=
ADMIN_MOBILE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Password reset emails (use an app password when using Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_NAME=Chandrabhaga Academy
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
